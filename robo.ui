         <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Мотор 5:</string></property></widget></item>
         <item row="4" column="1"><widget class="QProgressBar" name="temp_bar_4"><property name="value"><number>45</number></property></widget></item>
         <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Мотор 6:</string></property></widget></item>
