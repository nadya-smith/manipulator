         <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Мотор 1:</string></property></widget></item>
         <item row="0" column="1"><widget class="QProgressBar" name="temp_bar_0"><property name="value"><number>25</number></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property></widget></item>
         <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Мотор 2:</string></property></widget></item>
