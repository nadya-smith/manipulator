         </item>
         <!-- Оси -->
         <item row="2" column="0"><widget class="QLabel"><property name="text"><string>J1/X</string></property></widget></item>
         <item row="2" column="1"><widget class="QPushButton" name="btn_minus_0"><property name="text"><string>-</string></property></widget></item>
         <item row="2" column="2"><widget class="QPushButton" name="btn_plus_0"><property name="text"><string>+</string></property></widget></item>
         <item row="3" column="0"><widget class="QLabel"><property name="text"><string>J2/Y</string></property></widget></item>
         <item row="3" column="1"><widget class="QPushButton" name="btn_minus_1"><property name="text"><string>-</string></property></widget></item>
         <item row="3" column="2"><widget class="QPushButton" name="btn_plus_1"><property name="text"><string>+</string></property></widget></item>
