         <item row="6" column="2"><widget class="QPushButton" name="btn_plus_4"><property name="text"><string>+</string></property></widget></item>
         <item row="7" column="0"><widget class="QLabel"><property name="text"><string>J6/Rz</string></property></widget></item>
         <item row="7" column="1"><widget class="QPushButton" name="btn_minus_5"><property name="text"><string>-</string></property></widget></item>
         <item row="7" column="2"><widget class="QPushButton" name="btn_plus_5"><property name="text"><string>+</string></property></widget></item>
