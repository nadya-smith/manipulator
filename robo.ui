      <item>
       <widget class="QGroupBox" name="joy_group">
        <property name="title">
         <string>Ручное управление (Джойстик)</string>
        </property>
        <layout class="QGridLayout" name="joy_layout">
         <item row="0" column="0" colspan="2">
          <widget class="QLabel">
           <property name="text">
            <string>Режим:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="2" colspan="4">
          <widget class="QComboBox" name="mode_combo">
           <item>
            <property name="text">
             <string>MoveJ (по суставам)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>MoveL (линейно)</string>
            </property>
           </item>
