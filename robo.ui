         <item row="5" column="2"><widget class="QPushButton" name="btn_plus_3"><property name="text"><string>+</string></property></widget></item>
         <item row="6" column="0"><widget class="QLabel"><property name="text"><string>J5/Ry</string></property></widget></item>
