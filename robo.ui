         <item row="4" column="1"><widget class="QPushButton" name="btn_minus_2"><property name="text"><string>-</string></property></widget></item>
         <item row="4" column="2"><widget class="QPushButton" name="btn_plus_2"><property name="text"><string>+</string></property></widget></item>
